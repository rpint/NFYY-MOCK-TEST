  "knowledge_base": [
    {
      "id": "KB001",
      "title": "CKD各分期蛋白质摄入推荐",
      "content": "CKD G1-G2期：蛋白质摄入0.8-1.0 g/kg/d；CKD G3-G5期（非透析）：0.6-0.8 g/kg/d；透析期：1.0-1.2 g/kg/d。儿童需保证最低蛋白质需求以支持生长发育，不建议过度限制。",
      "tags": ["蛋白质限制", "CKD分期", "营养管理"]
    },
    {
      "id": "KB002",
      "title": "儿童CKD高钾血症饮食管理",
      "content": "血钾>5.5 mmol/L时需严格限钾（<2000mg/d）。避免高钾食物：香蕉、橙子、土豆、番茄酱、坚果等。蔬菜可先浸泡切碎后水煮去钾。避免使用低钠盐（含氯化钾）。",
      "tags": ["高钾血症", "电解质", "饮食管理"]
    },
    {
      "id": "KB003",
      "title": "儿童CKD钙磷代谢管理",
      "content": "CKD G3期起需监测钙磷和PTH。限磷饮食（600-1200mg/d视年龄），避免高磷食物（动物内脏、加工食品、可乐）。碳酸钙作为磷结合剂需随餐服用。维生素D不足时补充活性维生素D。",
      "tags": ["钙磷代谢", "高磷血症", "PTH", "维生素D"]
    },
    {
      "id": "KB004",
      "title": "儿童CKD生长迟缓营养干预",
      "content": "CKD儿童生长迟缓发生率高。需保证充足能量摄入（推荐同龄RDA的100-120%），监测身高增长速率。必要时使用生长激素。营养干预目标：BMI维持在P25-P75，身高追赶生长。",
      "tags": ["生长迟缓", "能量摄入", "生长激素"]
    },
    {
      "id": "KB005",
      "title": "儿童透析患者营养管理要点",
